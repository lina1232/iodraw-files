  <diagram name="第 1 页" id="UY9b1AvYDLixOWvWGb-z">
    <mxGraphModel dx="1430" dy="757" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rGEQe4MU6wgLsFgjn_mt-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rGEQe4MU6wgLsFgjn_mt-20" target="rGEQe4MU6wgLsFgjn_mt-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rGEQe4MU6wgLsFgjn_mt-20" value="&lt;font face=&quot;宋体&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;S1：通过佩戴于耳后的柔性贴片同步采集脑电信号、脉搏波信号与头部运动信号&lt;/span&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rGEQe4MU6wgLsFgjn_mt-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rGEQe4MU6wgLsFgjn_mt-21" target="rGEQe4MU6wgLsFgjn_mt-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rGEQe4MU6wgLsFgjn_mt-21" value="&lt;font face=&quot;宋体&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;S2：对脑电信号进行前置放大、带通滤波与陷波滤波，对脉搏波信号进行带通滤波与直流分量消除&lt;/span&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rGEQe4MU6wgLsFgjn_mt-22" value="S3：从去噪后的脑电信号中提取中枢通路特征，从脉搏波信号中提取外周通路特征，从头部运动信号中提取运动强度特征" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rGEQe4MU6wgLsFgjn_mt-23" value="S4-1：在标定期内建立个体化基线区间，并估计脑电信号与脉搏波信号之间的个体化传导延迟&lt;p style=&quot;line-height:150%&quot; class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-size:12.0pt;&amp;lt;br/&amp;gt;line-height:150%;font-family:宋体;mso-hansi-font-family:&amp;quot;Times New Roman&amp;quot;&quot;&gt;&lt;span lang=&quot;EN-US&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rGEQe4MU6wgLsFgjn_mt-24" value="S4-2：按个体化传导延迟对中枢通路特征与外周通路特征进行延迟补偿对齐" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="200" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rGEQe4MU6wgLsFgjn_mt-25" value="S4-3：以各模态偏离向量之间的方向一致性生成门控增益，对融合权重进行门控" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="320" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rGEQe4MU6wgLsFgjn_mt-26" value="S4-4：以第一时长窗与第二时长窗分别得到快通路评分与慢通路评分，按先触发、后确认的时序关系输出压力负荷评分、唤醒水平评分与放松状态评分" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="440" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rGEQe4MU6wgLsFgjn_mt-27" value="S5：将当前模态偏离向量投影至个体化升级方向模板，根据轨迹投影系数、轨迹相似度、偏移速率与累积负荷计算情绪爆发风险值，在风险值超过预警阈值时输出预警信号" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="560" width="280" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
